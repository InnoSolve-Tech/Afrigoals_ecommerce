# Public example values only. Do NOT commit real secrets.

# -------------------------------------------------------------------
# API (Go backend)
# -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
AFRIGOALS_API_URL=http://localhost:8080/api/v1


# -------------------------------------------------------------------
# Google OAuth
# -------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE


# -------------------------------------------------------------------
# Database (Neon Postgres)
# -------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# -------------------------------------------------------------------
# Vercel / AI Gateway (optional)
# -------------------------------------------------------------------
AI_GATEWAY_API_KEY=YOUR_VALUE_HERE

# -------------------------------------------------------------------
# Email (Resend)
# -------------------------------------------------------------------
RESEND_API_KEY=YOUR_VALUE_HERE

# -------------------------------------------------------------------
# Payments: IOTEC mobile money + cash on delivery
# All IOTEC credentials belong in the Go API environment, never here.
NEXT_PUBLIC_MOBILE_MONEY_ENABLED=true
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -------------------------------------------------------------------
# Google Maps
# -------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API=YOUR_VALUE_HERE
GOOGLE_MAPS_SERVER_API=YOUR_VALUE_HERE
NEXT_PUBLIC_GOOGLE_MAP_ID=YOUR_VALUE_HERE

# -------------------------------------------------------------------
# Store Location
# -------------------------------------------------------------------
STORE_NAME="Afrigoals Store"
STORE_LAT=0.31622566394454515
STORE_LNG=32.57507330900026

# -------------------------------------------------------------------
# Legacy delivery defaults (UGX)
# Checkout now uses the Go API settings saved at /admin/delivery-pricing.
# -------------------------------------------------------------------
DELIVERY_BASE_FEE=2500
DELIVERY_MIN_FEE=4000
DELIVERY_MAX_DISTANCE_KM=35
DELIVERY_ROUND_TO_NEAREST=500

# -------------------------------------------------------------------
# Fuel Model
# -------------------------------------------------------------------
FUEL_PETROL_PER_LITRE=4950
FUEL_MOTORCYCLE_KM_PER_LITRE=30
FUEL_ROUND_TRIP_FACTOR=1.6
FUEL_RIDER_MARGIN_PER_KM=336

# -------------------------------------------------------------------
# Traffic Multipliers
# -------------------------------------------------------------------
TRAFFIC_PEAK_MULTIPLIER=1.4
TRAFFIC_MODERATE_MULTIPLIER=1.15
TRAFFIC_OFF_PEAK_MULTIPLIER=1.0

# Show the MTN / Airtel mobile money checkout option (public, non-secret).
NEXT_PUBLIC_MOBILE_MONEY_ENABLED=true
